          "legendFormat": "{{biz_tag}} step"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (biz_tag) (increase(yunanexus_segment_optimistic_lock_conflict_total[10m]))",
          "legendFormat": "{{biz_tag}} lock-conflict(10m)"
