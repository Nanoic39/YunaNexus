# YunaNexus · Docker Compose 联调环境变量示例
#
# 用法：
#   cp deploy/.env.example deploy/.env
#   按需填写敏感值后执行：docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
#
# ⚠️ 禁止把 deploy/.env 提交到仓库（.gitignore 已忽略）；生产密钥走 K8s Secret / 环境变量。

# ---------- 中间件镜像与凭据 ----------
MYSQL_IMAGE=mysql:8.4
MYSQL_ROOT_PASSWORD=password
REDIS_IMAGE=redis:7.4-alpine
REDIS_PASSWORD=
NACOS_IMAGE=nacos/nacos-server:v3.0.2
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
ROCKETMQ_IMAGE=apache/rocketmq:5.3.1

# ---------- 运行 profile ----------
SPRING_PROFILES_ACTIVE=docker

# ---------- 认证/网关必需密钥（auth 缺失将拒绝启动，禁止使用仓库内任意默认值） ----------
# 生成方式（Windows/PowerShell）：见 misc/scripts/gen-local-keys.ps1
#            （Linux/macOS/WSL）：见 misc/scripts/gen-local-keys.sh
# 生产环境：openssl rand -base64 32（AES/HMAC）与 RSA3072 密钥对，经 Secret 注入
JWT_ACTIVE_KID=v1
JWT_PUBLIC_KEY_V1=
JWT_PRIVATE_KEY_V1=
# 可选：多版本密钥轮换（未注入的版本视为「尚未启用」自动跳过，见 docs/jwt-operations.md）
JWT_PUBLIC_KEY_V2=
JWT_PRIVATE_KEY_V2=
EXTERNAL_ID_AES_KEY_V1=
EXTERNAL_ID_HMAC_KEY_V1=

# ---------- 手机号能力开关（默认关闭：无 SMS 能力，不开放短信登录/手机号绑定） ----------
# 接入短信通道后改为 true 重开，代码零改动
AUTH_MOBILE_ENABLED=false
USER_MOBILE_ENABLED=false

# ---------- 管理后台密钥（为空表示未启用，对应 /admin/** 一律拒绝） ----------
AUTH_ADMIN_TOKEN=
PERMISSION_ADMIN_TOKEN=

# ---------- 网关 CORS 白名单（逗号分隔，禁止 *；为空表示不启用跨域） ----------
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- 可观测性（profile: ops） ----------
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.2.0
GRAFANA_ADMIN_PASSWORD=admin
SKYWALKING_IMAGE=apache/skywalking-oap-server:10.1.0
SKYWALKING_UI_IMAGE=apache/skywalking-ui:10.1.0
