      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (service) (increase(yunanexus_log_lines_total{level=~\"ERROR|FATAL\"}[15m]))",
          "legendFormat": "{{service}}",
          "range": true,
          "refId": "A"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "日志采集新鲜度",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "各服务最新一条日志距今秒数；持续增大说明该服务已静默或采集断链。",
      "gridPos": {
