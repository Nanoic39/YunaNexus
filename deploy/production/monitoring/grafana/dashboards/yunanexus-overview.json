    {
      "type": "timeseries",
      "title": "日志错误速率（15m）",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "近 15 分钟错误日志增量。告警规则在 >5 条时触发。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
