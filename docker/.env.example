# YunaNexus 生产环境变量
# 在服务器 /yunanexus/YunaNexusPackage/docker/ 目录下复制 .env.example 为 .env 并填写实际值

# 数据库密码
DB_ROOT_PASSWORD=

# Redis 密码（可留空）
REDIS_PASSWORD=

# Nacos
NACOS_AUTH_USERNAME=nacos
NACOS_AUTH_PASSWORD=nacos

# Nacos Auth Token（必须 ≥32 字节原始密钥的 Base64 编码值）
# 服务器上执行生成: openssl rand -base64 32
NACOS_AUTH_TOKEN=

# JWT 密钥
JWT_SECRET=

# OAuth 客户端 UUID（与 init-db.sh 中一致，首次初始化自动写入数据库）
OAUTH_CLIENT_UUID=

# OAuth 客户端密钥（明文，首次初始化时自动 bcrypt 存入数据库）
OAUTH_CLIENT_SECRET=

# 文件存储节点地址（服务宿主机运行，默认127.0.0.1:8300）
FILE_STORAGE_ENDPOINT=http://127.0.0.1:8300

# 邮件服务配置
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=YunaNexus

# 外部访问地址
PUBLIC_HOST=
PUBLIC_PORT=
