# YunaNexus 生产环境变量
# 需要在目标服务器复制的 {项目根目录}/docker/ 目录下复制为 .env 并填写实际值

# 数据库密码
DB_ROOT_PASSWORD=

# Redis密码(可以留空)
REDIS_PASSWORD=

# Nacos
NACOS_AUTH_USERNAME=nacos
NACOS_AUTH_PASSWORD=nacos

# Nacos Auth Token（必须 ≥32 字节原始密钥的 Base64 编码值）
# 服务器上执行生成: openssl rand -base64 32
NACOS_AUTH_TOKEN=

# RocketMQ密钥
ROCKETMQ_PROXY_SECRET_KEY=

# JWT密钥
JWT_SECRET=

# OAuth Core客户端 UUID（首次初始化时自动写入数据库）
OAUTH_CLIENT_UUID=

# OAuth 客户端密钥（明文，首次初始化时自动 bcrypt 存入数据库）
OAUTH_CLIENT_SECRET=

# 存储节点地址（Docker内部用容器名，外部用IP）
FILE_STORAGE_ENDPOINT=http://file:8300

# 邮件Host
MAIL_HOST=
# 邮件发送平台端口(以自己选择的平台为准)
MAIL_PORT=
# 邮件发送用户名
MAIL_USERNAME=
# 邮件授权码
MAIL_PASSWORD=
# 邮件来源地址(需要与用户名一致)
MAIL_FROM_ADDRESS=
# 外显来源名称
MAIL_FROM_NAME=【YunaNexus Dev.GROUP】

# 文件存储路径（相对于 docker-compose.yml 所在目录，即 ../ = PROJECT_DIR）
FILE_STORAGE_ROOT=../storage/yunanexus-file
FILE_TEMP_ROOT=../storage/yunanexus-file-temp

# Nacos 服务地址（Docker 内部使用 nacos 容器名）
NACOS_SERVER_ADDR=nacos:8848

# 前端外部访问地址
PUBLIC_HOST=
# 端口
PUBLIC_PORT=
