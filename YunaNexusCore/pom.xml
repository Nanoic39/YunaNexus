<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cc.nanoic.yunanexus</groupId>
        <artifactId>YunaNexus</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>YunaNexusCore</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>yunanexus-user</module>
        <module>yunanexus-common-security</module>
        <module>yunanexus-common-mail</module>
        <module>yunanexus-common-redis</module>
        <module>yunanexus-common-rocketmq</module>
        <module>yunanexus-auth</module>
    </modules>

    <!-- 版本管理 -->
    <properties>
        <maven.compiler.source>22</maven.compiler.source>
        <maven.compiler.target>22</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.boot.version>4.0.0</spring.boot.version>
        <spring.cloud.version>2025.1.0</spring.cloud.version>
        <spring.cloud.alibaba.version>2025.1.0.0</spring.cloud.alibaba.version>
        <spring.boot.starter.aop.version>3.4.7</spring.boot.starter.aop.version>
        <spring.boot.starter.validation.version>4.0.5</spring.boot.starter.validation.version>
        <spring.boot.starter.mail>4.0.0</spring.boot.starter.mail>
        <spring.boot.starter.rocketmq>2.3.0</spring.boot.starter.rocketmq>
        <mybatis.plus.version>3.5.15</mybatis.plus.version>
        <fastjson2.version>2.0.43</fastjson2.version>
        <fastjson2.extension.spring6.version>2.0.61</fastjson2.extension.spring6.version>
        <lombok.version>1.18.44</lombok.version>
        <hutool.version>5.8.26</hutool.version>
        <redisson.version>4.3.1</redisson.version>
        <yunanexus.common.security.version>1.0.0</yunanexus.common.security.version>
        <yunanexus.common.mail.version>1.0.0</yunanexus.common.mail.version>
        <yunanexus.common.redis.version>1.0.0</yunanexus.common.redis.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring.cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud Alibaba -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring.cloud.alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>


            <!-- MyBatisPlus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis.plus.version}</version>
            </dependency>

            <!-- Fastjson -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2-extension-spring6</artifactId>
                <version>${fastjson2.extension.spring6.version}</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <!-- Hutool -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- Redisson -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-aop</artifactId>
                <version>${spring.boot.starter.aop.version}</version>
            </dependency>

            <!-- Valid -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-validation</artifactId>
                <version>${spring.boot.starter.validation.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-mail</artifactId>
                <version>${spring.boot.starter.mail}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${spring.boot.starter.rocketmq}</version>
            </dependency>

            <!-- common -->

            <dependency>
                <groupId>cc.nanoic.yunanexus</groupId>
                <artifactId>yunanexus-common-security</artifactId>
                <version>${yunanexus.common.security.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.nanoic.yunanexus</groupId>
                <artifactId>yunanexus-common-mail</artifactId>
                <version>${yunanexus.common.mail.version}</version>
            </dependency>

            <dependency>
                <groupId>cc.nanoic.yunanexus</groupId>
                <artifactId>yunanexus-common-redis</artifactId>
                <version>1.0.0</version>
            </dependency>

            <dependency>
                <groupId>cc.nanoic.yunanexus</groupId>
                <artifactId>yunanexus-common-rocketmq</artifactId>
                <version>1.0.0</version>
            </dependency>

        </dependencies>
    </dependencyManagement>
</project>