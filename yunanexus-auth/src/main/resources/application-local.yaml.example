# 本地开发配置示例（复制为 application-local.yaml 使用）
# application-local.yaml 已被 .gitignore 忽略，禁止提交，本文件仅作占位示例。
#
# 说明：敏感配置（数据库密码、JWT/外部 ID 密钥等）统一走环境变量注入，
# 本文件只覆盖本地开发所需的最小差异项。
# 生产环境敏感配置走 K8s Secret / 环境变量，禁止写入任何配置文件（见 docs/deployment.md）。

spring:
  datasource:
    # 本地库地址与账号密码，按需修改（生产环境请勿在此填写真实密码）
    url: jdbc:mysql://localhost:3306/yunanexus_auth?serverTimezone=Asia/Shanghai&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: your_local_password

  data:
    redis:
      host: localhost
      port: 6379
      # password: your_local_redis_password   # 本地 Redis 默认无密码

yunanexus:
  auth:
    # 本地开发：回显验证码便于联调（生产必须为 false）
    captcha:
      dev-return-code: true
    jwt:
      # 本地开发 JWT RS256 密钥请勿写死在本文件。
      # 请在启动前于当前终端注入 JWT_PUBLIC_KEY_V1 / JWT_PRIVATE_KEY_V1 / JWT_ACTIVE_KID，
      # 生成方式见 docs/jwt-operations.md（PowerShell 7 生成 RSA3072 并直接注入环境变量）。
      # 注意：IDEA 等工具启动的进程不会自动继承你手动 export 的 env，需在运行配置中设置相同变量名。
      active-kid: ${JWT_ACTIVE_KID:v1}
      keys:
        - kid: v1
          public-key-base64: ${JWT_PUBLIC_KEY_V1:}
          private-key-base64: ${JWT_PRIVATE_KEY_V1:}
    external-id:
      keys:
        # 本地开发外部 ID 密钥请勿写死在本文件。
        # 请在启动前注入 EXTERNAL_ID_AES_KEY_V1 / EXTERNAL_ID_HMAC_KEY_V1。
        # AES 密钥 16 字节，HMAC 密钥 32 字节，均为 Base64；
        # 本地生成可用临时值：openssl rand -base64 16 / openssl rand -base64 32，禁止提交实际值。
        - version: 1
          aes-key-base64: ${EXTERNAL_ID_AES_KEY_V1:}
          hmac-key-base64: ${EXTERNAL_ID_HMAC_KEY_V1:}
