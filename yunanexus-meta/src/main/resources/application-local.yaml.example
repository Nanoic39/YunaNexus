# 本地开发配置示例（复制为 application-local.yaml 使用）
# application-local.yaml 已被 .gitignore 忽略，禁止提交，本文件仅作占位示例。
#
# 说明：敏感配置（数据库密码等）统一走环境变量注入，本文件只覆盖本地开发所需的最小差异项。
# 生产环境敏感配置走 K8s Secret / 环境变量，禁止写入任何配置文件（见 docs/deployment.md）。

spring:
  datasource:
    # 本地库地址与账号密码，按需修改（生产环境请勿在此填写真实密码）
    url: jdbc:mysql://localhost:3306/yunanexus_meta?serverTimezone=Asia/Shanghai&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: your_local_password
